#!/usr/bin/env bash
# ShellMate pre-commit hook: lint + test before every commit that touches code.
# Enable once per clone with:  make hooks
# Skip a single commit with:   git commit --no-verify
#
# Note: runs against the working tree, not just the staged changes.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Docs-only commits don't need the suite.
if ! git diff --cached --name-only --diff-filter=ACMR \
    | grep -Eq '(\.sh$|^\.bash_profile$|^Makefile$|^\.shellcheckrc$|^docker/)'; then
  exit 0
fi

echo "pre-commit: make lint + make test (skip with --no-verify)"

if command -v shellcheck >/dev/null 2>&1; then
  make --no-print-directory lint
else
  # Don't block contributors without ShellCheck (e.g. Windows); CI still lints.
  echo "pre-commit: shellcheck not installed; skipping lint (CI will run it)" >&2
fi

make --no-print-directory test
